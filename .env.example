# Copy to .env.local (never commit real values — .env* is gitignored) and, on
# Vercel, add the same names under Project → Settings → Environment Variables,
# then REDEPLOY: the whole site is statically generated, so metadata URLs and
# whether the Investment Info form is enabled are both decided at build time.

# Canonical site origin — feeds metadataBase (so canonical/og:url/og:image/
# twitter:image resolve correctly), the sitemap, robots.txt, and JSON-LD. See
# src/lib/site.ts. Defaults to the real production domain if unset, so this
# is optional in Vercel's Production environment; set it explicitly there
# anyway so it's not relying on the fallback, and set it to
# http://localhost:3000 in your own .env.local for exact local URLs.
NEXT_PUBLIC_SITE_URL=https://www.atexpresswayltd.com

# Both of the following must be set. With either missing the form renders
# disabled ("Coming soon") and /api/investment-interest answers 503 — it
# never pretends to send. See src/lib/investment-mail.ts.

# API key from https://resend.com (Resend is the provider chosen for the
# Investment Info form; only src/lib/investment-mail.ts knows that).
RESEND_API_KEY=

# The "From" address. Must be a sender/domain verified in Resend, e.g.
#   A.T. Expressway Website <no-reply@atexpressway.com>
# Submissions are delivered to the address in `contact.email`
# (src/content/project.ts, currently info@atexpressway.com) — the recipient is
# not configured here.
INVESTMENT_MAIL_FROM=
